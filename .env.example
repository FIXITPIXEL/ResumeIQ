# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose: "groq" (fast, free tier) or "openai"
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=gpt-4o-mini   # if using openai
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── API Keys ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── JSearch API (Optional for live job discovery) ──────────────────────────────
# Provider: "openwebninja" or "rapidapi"
JSEARCH_API_KEY=your_jsearch_api_key_here
JSEARCH_CREDIT_CAP=50
JSEARCH_CACHE_TTL=3600

# ── Embedding Model ────────────────────────────────────────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2

# ── Scoring Weights (must sum to 1.0) ─────────────────────────────────────────
SEMANTIC_WEIGHT=0.55
SKILL_WEIGHT=0.35
SENIORITY_WEIGHT=0.10

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
